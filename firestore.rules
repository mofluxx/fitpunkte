rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Team-Daten (Punkte, Einträge, Belohnungen)
    match /fitpunkte/{code} {
      function signedIn() { return request.auth != null; }
      function members()  { return resource.data.get('members', []); }
      function isMember() { return signedIn() && request.auth.uid in members(); }
      // Beitreten mit Code: nur sich selbst zur Mitgliederliste hinzufügen
      function joining() {
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(members())
          && request.resource.data.members.size() == members().size() + 1
          && request.auth.uid in request.resource.data.members;
      }
      // alte Teams von vor dem Google-Login (noch ohne Mitgliederliste)
      function legacy() { return signedIn() && !('members' in resource.data); }

      allow get:    if isMember() || legacy();
      allow create: if signedIn() && code.size() >= 20 && request.resource.data.members == [request.auth.uid];
      allow update: if (isMember() && request.resource.data.members.size() > 0) || joining();
      // Konto löschen: letztes Mitglied darf das Team löschen
      allow delete: if isMember() && members().size() == 1;

      // Essen: jeder Eintrag gehört einer Person (Dokument-ID beginnt mit ihrer UID)
      match /food/{entry} {
        function teamMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/fitpunkte/$(code)).data.get('members', []);
        }
        allow read: if teamMember();
        allow create, update: if teamMember()
          && entry.matches(request.auth.uid + '_.*')
          && request.resource.data.uid == request.auth.uid;
        allow delete: if teamMember() && entry.matches(request.auth.uid + '_.*');
      }
    }

    // Merkt sich pro Konto, zu welchem Team es gehört (+ Push-Token)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
